   "section": "intro",
   "items": [
    {
     "role": "body",
     "order": 0,
     "text": "art of the University of Texas System, UT MD Anderson is one of the world’s most respected centers devoted exclusively to cancer patient care, research, education and prevention."
    },
    {
     "role": "body",
     "order": 1,
     "text": "P"
    },
    {
     "role": "body",
     "order": 2,
     "text": "Part of the University of Texas System, UT MD Anderson is one of the world’s most respected centers devoted exclusively to cancer patient care, research, education and prevention."
    }
   ],
