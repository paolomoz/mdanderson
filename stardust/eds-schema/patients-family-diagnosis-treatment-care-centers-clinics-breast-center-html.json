    },
    {
     "role": "cta",
     "order": 30,
     "text": "HER2-positive breast cancer",
     "href": "/cancer-types/breast-cancer.html#HER2"
    },
    {
     "role": "cta",
     "order": 31,
     "text": "Hormone receptor-positive/ER-positive breast cancer",
     "href": "/cancer-types/breast-cancer.html#hormone"
    },
    {
