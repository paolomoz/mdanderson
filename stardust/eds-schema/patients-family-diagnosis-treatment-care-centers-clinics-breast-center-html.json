    },
    {
     "role": "cta",
     "order": 60,
     "text": "Breast Cancer Breast cancer occurs when a cell in the breast mutates and starts multiplying rapidly. There are mor...",
     "href": "https://www.mdanderson.org/cancer-types/breast-cancer.html"
    },
    {
     "role": "cta",
     "order": 61,
     "text": "Inflammatory Breast Cancer Learn about inflammatory breast cancer signs, diagnosis, causes, risk factors, and treatment options...",
     "href": "https://www.mdanderson.org/cancer-types/inflammatory-breast-cancer.html"
    },
    {
     "role": "cta",
     "order": 62,
     "text": "Implant-associated ALCL UT MD Anderson's Reconstructive Surgery Center provides quality care for breast implant-associated a...",
     "href": "https://www.mdanderson.org/cancer-types/breast-implant-associated-anaplastic-large-cell-lymphoma.html"
    },
    {
     "role": "cta",
     "order": 63,
     "text": "Breast Reconstruction Breast reconstruction surgery recreates all or a part of your breast that has been surgically remove...",
     "href": "https://www.mdanderson.org/treatment-options/breast-reconstruction.html"
    },
    {
     "role": "cta",
     "order": 64,
     "text": "Inflammatory Breast Cancer Research Program The UT MD Anderson Inflammatory Breast Cancer Research Program extensively studies the very rare form of breast cancer.",
     "href": "https://www.mdanderson.org/research/departments-labs-institutes/programs-centers/inflammatory-breast-cancer-research-program.html"
    },
    {
     "role": "cta",
     "order": 65,
     "text": "Clinical Cancer Genetics Program The UT MD Anderson Clinical Cancer Genetics Program coordinates genetic testing and high-risk surveillance.",
     "href": "https://www.mdanderson.org/research/departments-labs-institutes/programs-centers/clinical-cancer-genetics.html"
    },
    {
     "role": "cta",
     "order": 66,
     "text": "Breast Cancer Support Groups UT MD Anderson hosts support groups across the Houston area for breast cancer patients of all ages.",
     "href": "https://www.mdanderson.org/patients-family/diagnosis-treatment/patient-support/support-groups.html"
    },
