    {
      "id": "f-97cd97da65",
      "source": "rollout:eyeball",
      "layer": "design-ux",
      "check": "cards-icon-variant-collision",
      "severity": "P1",
      "scope": {
        "level": "page",
        "ids": [
          "about-md-anderson-html",
          "cancerwise-how-to-cope-with-insomnia-during-cancer-treatment-h00-159856134-html",
